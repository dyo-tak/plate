# Copy this file to .env.production (and fill in) or .env.local (gitignored).
# Public client IDs are safe to commit; secrets are not.

# Google Drive
VITE_GOOGLE_CLIENT_ID=

# OneDrive (Azure AD app registration)
VITE_MS_CLIENT_ID=

# GitHub (OAuth app) — used for the OAuth flow only; the PAT option
# bypasses this entirely.
VITE_GH_CLIENT_ID=
